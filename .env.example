# Application Security & Admin Auth
APP_SECRET_KEY=change-me-to-a-secure-random-64-character-string
ADMIN_USERNAME=admin
# Default admin password is 'admin123' (bcrypt hashed below)
ADMIN_PASSWORD_HASH=$2b$12$mmI1RSXysbBk2xuthfZQfuw3nZYfIMB2vv7ot101IWIwfamsczr6S

# Database Configuration
DATABASE_URL=sqlite:///./recruitment.db

# Email & Inbox Service
EMAIL_PROVIDER=mock
MOCK_INBOX=true

# Agent Autonomous Poller Settings
AGENT_TICK_INTERVAL_SECONDS=30
OUTBOX_BATCH_SIZE=50
AGENT_CONFIDENCE_THRESHOLD=0.7
AGENT_MAX_CLARIFICATIONS=2
AGENT_MAX_LLM_ATTEMPTS=3
AGENT_CLAIM_TIMEOUT_SECONDS=300
AGENT_CONTEXT_MESSAGES=10
AGENT_MAX_OUTBOUND_PER_DAY=6
WEBHOOK_SECRET=

# Gemini AI / LLM Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20

# Telephony Configuration (Twilio / Telnyx)
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
